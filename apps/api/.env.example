# Copie para .env. Todos os valores abaixo sao de DESENVOLVIMENTO.
# Em producao: ENV=production exige SECRET_KEY forte (o app recusa subir com o default).

ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Postgres/Redis do docker-compose (portas do host: 5433 e 6380 para nao colidir com instalacoes locais)
DATABASE_URL=postgresql+asyncpg://lux:lux@localhost:5433/lux_delivery
REDIS_URL=redis://localhost:6380/0

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Opcional: permite criar o primeiro admin via POST /api/v1/auth/bootstrap-admin
BOOTSTRAP_ADMIN_TOKEN=

CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1

# Rate limiting
RATE_LIMIT_MAX_PER_IP=300
RATE_LIMIT_MAX_PER_USER=600
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Imagens: "local" (MEDIA_ROOT servido em /media) ou "s3" (S3, R2, MinIO, Supabase S3)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
# S3_BUCKET=lux-media
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Usuarios de demonstracao criados pelo seed (python -m app.scripts.seed)
SEED_ADMIN_EMAIL=admin@lux.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_CUSTOMER_EMAIL=cliente@lux.dev
SEED_CUSTOMER_PASSWORD=Cliente@12345
