    {
      "id": 16,
      "type": "timeseries",
      "title": "Postgres: transacoes/s e cache hit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"lux_delivery\"}[1m]))",
          "refId": "A",
          "legendFormat": "commits/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_database_blks_hit{datname=\"lux_delivery\"}) / clamp_min(sum(pg_stat_database_blks_hit{datname=\"lux_delivery\"}) + sum(pg_stat_database_blks_read{datname=\"lux_delivery\"}), 1)",
          "refId": "B",
          "legendFormat": "buffer hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
