          "refId": "A",
          "legendFormat": "usada"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "redis_memory_max_bytes",
          "refId": "B",
          "legendFormat": "limite"
